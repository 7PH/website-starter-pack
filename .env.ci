# CI environment file - used by GitHub Actions

# Project name
COMPOSE_PROJECT_NAME=starterpack
COMPOSE_FILE=docker-compose.core.yml:docker-compose.yml
APP_NAME=CI Test App

# Docker user (CI runner)
DOCKER_USER=ci
DOCKER_UID=1001
DOCKER_GID=127

# Traefik (not used in CI but required)
USE_TLS=
PUBLIC_PORT=13001
PUBLIC_WEBSITE_HOST=localhost
TRAEFIK_DASHBOARD_PORT=13080
BACKEND_DEBUG_PORT=15679

# Public URL
PUBLIC_URL=http://localhost:13001

# Auth tokens
TOKEN_HASH_SECRET=ci-test-secret-do-not-use-in-production
INTERNAL_API_KEY=ci-internal-key

# Security headers (defaults match .env.template)
SECURITY_FRAME_OPTIONS=SAMEORIGIN
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=()"
EXTRA_ALLOWED_ORIGINS=

# Database
APP_DB_NAME=app
APP_DB_USER=postgres
APP_DB_PASSWORD=ci-test-password

# i18n
DEFAULT_LOCALE=en

# Disabled services
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_FROM_NAME=
ADMIN_EMAIL=ci@localhost
BASIC_AUTH=
BASIC_AUTH_EVERYWHERE=
STRIPE_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
USER_STRIPE_PRICE_IDS=

# Organizations (disabled in CI)
ORGANIZATIONS_ENABLED=false
ORG_MAX_PER_USER=1
ORG_MAX_MEMBERS=50
ORG_STRIPE_PRICE_IDS=
ORG_SELF_SERVICE_SUBSCRIPTIONS=true
ORG_SELF_SERVICE_CREATION=true
ORG_INVITATIONS_ENABLED=false
ORG_INVITATION_EXPIRY_DAYS=7

# Managed accounts (disabled in CI)
MANAGED_ACCOUNTS_ENABLED=false
MANAGED_ACCOUNT_GROUP_MAX_PER_USER=20
MANAGED_ACCOUNTS_MAX_PER_USER=50

# OAuth (disabled in CI)
OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM (disabled in CI)
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=
LLM_API_BASE=

# Adminer
ADMINER_SUBDOMAIN=adminer
NUXT_PUBLIC_ADMINER_URL=

# Backend resource limits
BACKEND_CPU_LIMIT=2
BACKEND_MEMORY_LIMIT=1G
BACKEND_CPU_RESERVATION=0.5
BACKEND_MEMORY_RESERVATION=256M

# Umami (disabled in CI)
UMAMI_SUBDOMAIN=analytics
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=ci-umami-password
UMAMI_APP_SECRET=ci-umami-secret
NUXT_PUBLIC_UMAMI_ENABLED=false
NUXT_PUBLIC_UMAMI_URL=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_PUBLIC_UMAMI_DASHBOARD_URL=
