        "items": {
          "items": {
            "$ref": "#/$defs/AdminUserRead"
          },
          "title": "Items",
          "type": "array"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "items",
        "total",
        "limit",
        "offset"
