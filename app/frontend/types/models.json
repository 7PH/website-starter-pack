      "type": "object"
    },
    "DatabaseHealthResponse": {
      "description": "Complete database health response.",
      "properties": {
        "database_size": {
          "title": "Database Size",
          "type": "integer"
        },
        "database_size_pretty": {
          "title": "Database Size Pretty",
          "type": "string"
        },
        "active_connections": {
          "title": "Active Connections",
          "type": "integer"
        },
        "max_connections": {
          "title": "Max Connections",
          "type": "integer"
        },
        "cache_hit_ratio": {
          "title": "Cache Hit Ratio",
          "type": "number"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/TableStats"
          },
          "title": "Tables",
          "type": "array"
        },
        "indexes": {
          "items": {
            "$ref": "#/$defs/IndexStats"
          },
          "title": "Indexes",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "required": [
        "database_size",
        "database_size_pretty",
        "active_connections",
        "max_connections",
        "cache_hit_ratio",
        "tables",
        "indexes",
        "recommendations"
      ],
      "title": "DatabaseHealthResponse",
      "type": "object"
    },
    "EventLogFilter": {
      "description": "Query parameters for filtering event logs.",
