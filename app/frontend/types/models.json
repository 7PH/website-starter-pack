    "AdminDashboardStats": {
      "description": "Dashboard statistics.",
      "properties": {
        "total_users": {
          "title": "Total Users",
          "type": "integer"
        },
        "admin_users": {
          "title": "Admin Users",
          "type": "integer"
        },
        "premium_users": {
          "title": "Premium Users",
          "type": "integer"
        },
        "recent_events": {
          "items": {
            "$ref": "#/$defs/EventLogRead"
          },
          "title": "Recent Events",
          "type": "array"
        }
      },
      "required": [
        "total_users",
        "admin_users",
        "premium_users",
        "recent_events"
      ],
      "title": "AdminDashboardStats",
      "type": "object"
    },
    "AdminUserListResponse": {
      "description": "Paginated response for user list.",
