    "BackupInfo": {
      "description": "Information about a single backup file.",
      "properties": {
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
