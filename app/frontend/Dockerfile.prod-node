# ⚠️ STARTERPACK CORE — DO NOT MODIFY. This file is managed by the starterpack.
FROM node:20-alpine3.20 AS build-stage

# Build-time values read by nuxt.config.ts (process.env). Populated from
# compose build.args; values originate in .env. Must be set BEFORE npm run build.
ARG SITEMAP_ENABLED=true
ARG CMS_ENABLED=false
ARG PUBLIC_URL
ARG STATIC_ORIGIN
ARG NUXT_PUBLIC_APP_NAME
ARG NUXT_PUBLIC_DEFAULT_LOCALE
ARG NUXT_PUBLIC_UMAMI_ENABLED
ARG UMAMI_SUBDOMAIN
ENV SITEMAP_ENABLED=${SITEMAP_ENABLED} \
    CMS_ENABLED=${CMS_ENABLED} \
    PUBLIC_URL=${PUBLIC_URL} \
    STATIC_ORIGIN=${STATIC_ORIGIN} \
    NUXT_PUBLIC_APP_NAME=${NUXT_PUBLIC_APP_NAME} \
    NUXT_PUBLIC_DEFAULT_LOCALE=${NUXT_PUBLIC_DEFAULT_LOCALE} \
    NUXT_PUBLIC_UMAMI_ENABLED=${NUXT_PUBLIC_UMAMI_ENABLED} \
    UMAMI_SUBDOMAIN=${UMAMI_SUBDOMAIN}

WORKDIR /app

COPY . .

RUN npm install
# Nitro's server bundling outgrows Node's ~2 GB default heap on larger sub-apps; scoped to the build only.
RUN NODE_OPTIONS=--max-old-space-size=4096 npm run build

FROM node:20-alpine3.20 AS running-stage

ENV NODE_ENV=production
ENV PORT=3000

WORKDIR /app

COPY --from=build-stage /app/.output /app/.output
COPY --from=build-stage /app/node_modules /app/node_modules

USER node

EXPOSE 3000
CMD ["sh", "-c", "node /app/.output/server/index.mjs"]
