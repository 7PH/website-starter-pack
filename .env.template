# ⚠️ STARTERPACK CORE — DO NOT MODIFY. This file is managed by the starterpack.

# --- Project ---

COMPOSE_PROJECT_NAME=<slugify,required>
COMPOSE_FILE=docker-compose.core.yml:docker-compose.yml
APP_NAME=${COMPOSE_PROJECT_NAME}

# --- Docker ---

# User used within containers to save/write files
# This should match the user owning the build directory and not be root.
DOCKER_USER=`id -un`
DOCKER_UID=`id -u`
DOCKER_GID=`id -g`

# --- Network ---

# Traefik entrypoint
USE_TLS=<*false|true>
PUBLIC_PORT=80
PUBLIC_WEBSITE_HOST=localhost

# Localhost-only dev ports. Override these (and PUBLIC_PORT, COMPOSE_PROJECT_NAME)
# to run multiple starterpacks in parallel on the same machine.
TRAEFIK_DASHBOARD_PORT=8080
BACKEND_DEBUG_PORT=5679

# Front-facing URL (can be different than traefik configuration if you use a reverse proxy in front of traefik).
# Override this to drop the default port (e.g. https://myapp.com) when behind a TLS-terminating proxy.
PUBLIC_URL=http://${PUBLIC_WEBSITE_HOST}:${PUBLIC_PORT}

# --- Security ---

# Basic auth for admin pages
# Generate using `htpasswd -nb user password`
# e.g. BASIC_AUTH="admin:\$apr1\$kLLUQByt\$Dni.Jm7ToVyC4fe8Web0P0"
BASIC_AUTH=
# Set to true to enable basic auth on all pages
BASIC_AUTH_EVERYWHERE=

# User password information
TOKEN_HASH_SECRET=<secret:64>

# Internal API key
INTERNAL_API_KEY=`openssl rand -hex 32`

# Security Headers (customize as needed, applied via Traefik)
SECURITY_FRAME_OPTIONS=SAMEORIGIN
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=()"

# Extra CORS origins for prod (comma-separated). Leave empty for same-origin
# setups (the default). Set when a non-web client calls the API from a
# different origin, e.g. a Capacitor mobile shell:
#   EXTRA_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
EXTRA_ALLOWED_ORIGINS=

# --- Database ---

APP_DB_NAME=app
APP_DB_USER=postgres
APP_DB_PASSWORD=<secret:64>

# Connection pool sizing. `pool_size` is the steady-state count, `max_overflow`
# is the burst headroom, `pool_timeout` is how long a request waits for a free
# connection before erroring. Default Postgres `max_connections` is 100, so
# keep (pool_size + max_overflow) * BACKEND_WORKERS comfortably under that.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Per-connection server-side timeouts (milliseconds; 0 disables). Caps runaway
# queries and transactions that idle while holding a pool slot. 30s is a
# reasonable starter default; tune up for slow analytics endpoints.
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# --- Backend ---

# Number of uvicorn worker processes (prod only; dev always uses --reload with 1
# worker). Set >1 to scale across CPU cores. >1 requires every scheduled job to
# use a cluster-singleton lock (see src/tasks/_scheduler.py::_run_once_per_cluster);
# the core backups/billing jobs already do.
BACKEND_WORKERS=1

# Backend container resource limits
BACKEND_CPU_LIMIT=2
BACKEND_MEMORY_LIMIT=1G
BACKEND_CPU_RESERVATION=0.5
BACKEND_MEMORY_RESERVATION=256M

# Header to read the real client IP from. Empty (default) = use the direct TCP
# peer. Set to e.g. `X-Forwarded-For` only when something in front of the
# backend (Traefik, an LB) is guaranteed to overwrite that header for every
# inbound request; otherwise a client can spoof their IP.
TRUSTED_IP_HEADER=

# --- Sitemap ---

# Build-time switch for the @nuxtjs/sitemap module. `true` (default) registers
# /sitemap.xml at runtime from `config/sitemap-ext.ts`. Set `false` for apps
# that own the sitemap themselves (precomputed XML on disk, high URL counts,
# cron-driven indexing). When disabled, the sub-app is responsible for serving
# /sitemap.xml — drop it in `app/frontend/public/`, register a custom
# `server/routes/sitemap.xml.ts`, or have upstream Nginx serve it. robots.txt
# still links to /sitemap.xml.
SITEMAP_ENABLED=true

# --- Admin ---

# Admin email
ADMIN_EMAIL=

# Adminer database management tool
ADMINER_SUBDOMAIN=adminer
# Full URL to Adminer (shown in admin panel, leave empty to hide link)
NUXT_PUBLIC_ADMINER_URL=

# --- i18n ---

DEFAULT_LOCALE=<*en|fr>

# --- Email ---

# Mailgun (email service)
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_FROM_NAME=

# --- Stripe ---

# Set STRIPE_ENABLED=true to enable billing features
STRIPE_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated Stripe price IDs offered to individual users on the
# /stripe/checkout flow. Leave empty to disable user self-service subscribe.
USER_STRIPE_PRICE_IDS=

# --- Organizations ---

# Set ORGANIZATIONS_ENABLED=true to enable org features
ORGANIZATIONS_ENABLED=false
ORG_MAX_PER_USER=1
ORG_MAX_MEMBERS=50
ORG_STRIPE_PRICE_IDS=
# Set to false to disable org self-service subscriptions (org admins can't subscribe themselves)
# App admins can still subscribe orgs through the admin panel
ORG_SELF_SERVICE_SUBSCRIPTIONS=true
# Set to false to disable user self-service org creation
# When false, only app admins can create organizations
ORG_SELF_SERVICE_CREATION=true
# Set to true to allow org admins to invite users by email.
ORG_INVITATIONS_ENABLED=false
# Days before an unaccepted invitation expires.
ORG_INVITATION_EXPIRY_DAYS=7

# --- Managed accounts ---

# Set MANAGED_ACCOUNTS_ENABLED=true to expose the managed-account-groups feature
# (one owner provisions email-less accounts that sign in by code).
# docker-compose forwards this to NUXT_PUBLIC_MANAGED_ACCOUNTS_ENABLED automatically.
MANAGED_ACCOUNTS_ENABLED=false
MANAGED_ACCOUNT_GROUP_MAX_PER_USER=20
MANAGED_ACCOUNTS_MAX_PER_USER=50

# --- LLM ---

# Set LLM_ENABLED=true to enable AI features
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=
LLM_API_BASE=

# OpenRouter example (https://openrouter.ai — has a free tier):
#   1. Sign up, grab a key from https://openrouter.ai/keys
#   2. Pick a model from https://openrouter.ai/models
#   3. Override the vars above with:
# LLM_PROVIDER=openrouter
# LLM_MODEL=deepseek/deepseek-r1:free
# LLM_API_KEY=sk-or-v1-...

# --- OAuth ---

# Set OAUTH_ENABLED=true and configure provider credentials
OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Analytics ---

# Umami Analytics
UMAMI_SUBDOMAIN=analytics
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=<secret:64>
UMAMI_APP_SECRET=<secret:64>

# Frontend analytics config (set after creating website in Umami)
NUXT_PUBLIC_UMAMI_ENABLED=false
NUXT_PUBLIC_UMAMI_URL=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
# Umami dashboard URL (shown in admin panel, leave empty to hide link)
NUXT_PUBLIC_UMAMI_DASHBOARD_URL=

# --- Starterpack ---

# Starter pack git repository
STARTER_PACK_GIT_REPOSITORY=https://github.com/7PH/website-starter-pack.git
